<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone / audio-input access under the hardened runtime. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Required by the WKWebView JavaScript engine under the hardened runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Allow loading the bundled Microsoft-signed libonnxruntime.dylib, which is
	     not signed by the same team as the app. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
