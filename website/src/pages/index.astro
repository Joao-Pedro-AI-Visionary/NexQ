---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Models from '../components/Models.astro';
import Stealth from '../components/Stealth.astro';
import Privacy from '../components/Privacy.astro';
import UseCases from '../components/UseCases.astro';
import Compare from '../components/Compare.astro';
import WhatsNew from '../components/WhatsNew.astro';
import Download from '../components/Download.astro';
import Community from '../components/Community.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main id="main" tabindex="-1" class="outline-hidden">
    <Hero />
    <Features />
    <Models />
    <Stealth />
    <Privacy />
    <UseCases />
    <WhatsNew />
    <Download />
    <Compare />
    <Community />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
