---
// Static illustration of the meeting view's context chip (v2.24).
// Option labels follow docs/user-guide/claude-subscription.md.
const options = [
  { label: 'Action default', hint: '' },
  { label: 'Since last answer', hint: '', active: true },
  { label: 'Since last answer of this action', hint: '' },
  { label: 'Last 2 · 5 · 10 · 15 min', hint: 'or custom' },
  { label: 'Whole meeting', hint: '' },
];
---

<div
  class="w-full max-w-[19rem] rounded-xl border border-line-strong bg-bg-panel/95 p-1.5 text-sm shadow-[0_24px_60px_-20px_rgba(0,0,0,0.85)] backdrop-blur"
  role="img"
  aria-label="Context scope menu with options: action default, since last answer, since last answer of this action, last 2, 5, 10 or 15 minutes, and whole meeting, plus a Keep for next actions switch."
>
  <div class="flex items-center justify-between px-2.5 pb-2 pt-1.5">
    <span class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3">Context</span>
    <span class="text-xs text-ink-3">for the next action</span>
  </div>
  <ul class="space-y-0.5" aria-hidden="true">
    {options.map((o) => (
      <li
        class:list={[
          'flex items-center justify-between rounded-lg px-2.5 py-2',
          o.active ? 'bg-brand/15 text-ink' : 'text-ink-2',
        ]}
      >
        <span class="flex items-center gap-2">
          <span class:list={['h-1.5 w-1.5 rounded-full', o.active ? 'bg-brand-ink' : 'bg-transparent']}></span>
          {o.label}
        </span>
        {o.hint && <span class="text-xs text-ink-3">{o.hint}</span>}
      </li>
    ))}
  </ul>
  <div class="mt-1.5 flex items-center justify-between border-t border-line px-2.5 pb-1 pt-2.5 text-ink-2" aria-hidden="true">
    <span>Keep for next actions</span>
    <span class="relative h-5 w-9 rounded-full bg-brand-btn">
      <span class="absolute right-0.5 top-0.5 h-4 w-4 rounded-full bg-white"></span>
    </span>
  </div>
</div>
