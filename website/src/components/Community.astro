---
import Icon from './Icon.astro';
import { REPO, CONTRIBUTING, ISSUES, LICENSE } from '../data/site';

const ways = [
  { title: 'Star the repo', body: 'The simplest way to help more people find NexQ.', href: REPO, cta: 'Star on GitHub' },
  { title: 'Report and suggest', body: 'Found a bug or missing a feature? Open an issue with the details.', href: ISSUES, cta: 'Open an issue' },
  { title: 'Contribute code', body: 'Rust, React and TypeScript. The guide covers setup, conventions and pull requests.', href: CONTRIBUTING, cta: 'Read CONTRIBUTING.md' },
];
---

<section id="community" class="section border-t border-line" aria-labelledby="community-title">
  <div class="wrap">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">Open source</p>
        <h2 id="community-title" class="h2 mt-4">Built in the open, with the people who use it.</h2>
        <p class="lede">
          NexQ is MIT-licensed and developed on GitHub. The macOS version in v2.25 came from a community contribution,
          and there is room for yours.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={REPO} target="_blank" rel="noopener" class="inline-flex items-center rounded-lg" aria-label="NexQ GitHub stars">
            <img
              src="https://img.shields.io/github/stars/naxhq/NexQ?style=for-the-badge&logo=github&logoColor=eef1f7&label=Stars&labelColor=161a24&color=2563eb&cacheSeconds=3600"
              alt="GitHub stars for naxhq/NexQ"
              height="28"
              class="h-7 w-auto"
              loading="lazy"
              decoding="async"
            />
          </a>
          <a href={LICENSE} target="_blank" rel="noopener" class="inline-flex items-center rounded-lg" aria-label="MIT license">
            <img
              src="https://img.shields.io/badge/License-MIT-161a24?style=for-the-badge&labelColor=161a24&color=11141c"
              alt="License: MIT"
              height="28"
              class="h-7 w-auto"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      </div>

      <ul class="lg:col-span-7">
        {ways.map((w, i) => (
          <li class="border-t border-line last:border-b" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <a
              href={w.href}
              target="_blank"
              rel="noopener"
              class="group flex items-center justify-between gap-6 py-7"
            >
              <span>
                <span class="block text-lg font-medium text-ink">{w.title}</span>
                <span class="mt-1.5 block text-[0.9375rem] leading-relaxed text-ink-2">{w.body}</span>
                <span class="mt-3 inline-flex items-center gap-1 text-sm text-brand-ink">{w.cta}</span>
              </span>
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line-strong text-ink-2 transition-[transform,color,border-color] duration-300 ease-spring group-hover:translate-x-1 group-hover:border-brand/50 group-hover:text-ink">
                <Icon name="arrow-right" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
