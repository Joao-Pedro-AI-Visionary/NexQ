---
import { REPO, RELEASES, CHANGELOG, CONTRIBUTING, LICENSE, ISSUES, doc } from '../data/site';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const groups = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '#features' },
      { label: 'Stealth mode', href: '#stealth' },
      { label: 'Claude subscription', href: '#claude' },
      { label: 'What’s new', href: '#whats-new' },
      { label: 'Download', href: '#download' },
    ],
  },
  {
    title: 'Docs',
    links: [
      { label: 'Getting started', href: doc('getting-started') },
      { label: 'AI providers', href: doc('ai-providers') },
      { label: 'Keyboard shortcuts', href: doc('keyboard-shortcuts') },
      { label: 'Troubleshooting', href: doc('troubleshooting') },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: REPO },
      { label: 'Releases', href: RELEASES },
      { label: 'Changelog', href: CHANGELOG },
      { label: 'Contributing', href: CONTRIBUTING },
      { label: 'Issues', href: ISSUES },
    ],
  },
];
---

<footer class="border-t border-line bg-bg-sunken" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">Site footer</h2>
  <div class="wrap grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-4">
      <a href={base} class="inline-flex items-center gap-2.5 rounded-lg" aria-label="NexQ home">
        <img src={`${base}img/logo-96.png`} alt="" width="28" height="28" class="rounded-[7px]" loading="lazy" />
        <span class="text-[1.05rem] font-semibold tracking-tight text-ink">NexQ</span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-3">
        Open-source AI meeting assistant and real-time interview copilot for Windows and macOS.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-8">
      {groups.map((g) => (
        <nav aria-label={g.title}>
          <h3 class="font-mono text-xs uppercase tracking-[0.12em] text-ink-3">{g.title}</h3>
          <ul class="mt-4 space-y-1">
            {g.links.map((l) => {
              const external = l.href.startsWith('http');
              return (
                <li>
                  <a
                    href={l.href}
                    class="inline-flex min-h-[32px] items-center text-sm text-ink-2 transition-colors hover:text-ink"
                    {...(external ? { target: '_blank', rel: 'noopener' } : {})}
                  >
                    {l.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      ))}
    </div>
  </div>
  <div class="wrap flex flex-col gap-2 border-t border-line py-8 text-sm text-ink-3 sm:flex-row sm:items-center sm:justify-between">
    <span>© {year} Vahid Alizadeh and contributors</span>
    <a href={LICENSE} target="_blank" rel="noopener" class="hover:text-ink-2">MIT License</a>
  </div>
</footer>
