---
import Icon from './Icon.astro';
import { RELEASES_HIGHLIGHTS, CHANGELOG, RELEASES } from '../data/site';

const fmt = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<section id="whats-new" class="section border-t border-line" aria-labelledby="whats-new-title">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end" data-reveal>
      <div class="max-w-3xl">
        <p class="eyebrow">What's new</p>
        <h2 id="whats-new-title" class="h2 mt-4">Recently shipped.</h2>
      </div>
      <a href={CHANGELOG} target="_blank" rel="noopener" class="btn-ghost self-start sm:self-auto">
        Full changelog <Icon name="arrow-up-right" />
      </a>
    </div>

    <ol class="mt-14 border-t border-line">
      {RELEASES_HIGHLIGHTS.map((r, i) => (
        <li class="grid gap-6 border-b border-line py-10 lg:grid-cols-12 lg:gap-12" data-reveal>
          <div class="lg:col-span-4">
            <div class="flex items-center gap-3">
              <h3 class:list={['font-mono text-2xl font-medium tracking-tight', i === 0 ? 'text-ink' : 'text-ink-2']}>
                v{r.version}
              </h3>
              {r.label && (
                <span class="rounded-full bg-live/10 px-2.5 py-0.5 text-xs font-medium text-live">{r.label}</span>
              )}
            </div>
            {r.date && <p class="mt-1.5 text-sm text-ink-3"><time datetime={r.date}>{fmt(r.date)}</time></p>}
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2 lg:max-w-xs">{r.summary}</p>
          </div>
          <ul class="grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:col-span-8">
            {r.items.map((it) => (
              <li>
                <p class="font-medium text-ink">{it.title}</p>
                <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink-2">{it.body}</p>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-sm text-ink-3">
      Downloads and release notes for every version are on <a href={RELEASES} target="_blank" rel="noopener" class="link">GitHub Releases</a>.
    </p>
  </div>
</section>
