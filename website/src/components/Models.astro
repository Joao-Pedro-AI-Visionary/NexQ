---
import Icon from './Icon.astro';
import { LLM_PROVIDERS, doc } from '../data/site';

// Tier defaults from docs/user-guide/claude-subscription.md
const tiers = [
  {
    name: 'Fast',
    model: 'Haiku',
    effort: 'Low',
    thinking: 'Off',
    use: 'Live answers: Assist, What to say, Shorten, Follow-up, Ask',
  },
  {
    name: 'Deep',
    model: 'Sonnet',
    effort: 'Medium',
    thinking: 'On',
    use: 'Recaps, summaries, action items, asking a past meeting',
  },
];

const claudePoints = [
  {
    icon: 'refresh',
    title: 'Warm sessions',
    body: 'A session opens when the meeting starts, preloaded with your scenario and documents. Each request sends only the transcript that is new.',
  },
  {
    icon: 'sparkle',
    title: 'About a second to first words',
    body: 'With extended thinking off, Haiku starts answering almost immediately. Turn thinking on per tier when a question deserves it.',
  },
  {
    icon: 'terminal',
    title: 'Real numbers',
    body: 'Tokens, cost and response time for every request, as Claude reports them, in the footer and the AI Log.',
  },
  {
    icon: 'shield',
    title: 'Sandboxed and fail-safe',
    body: 'The official CLI runs with all tools disabled in an empty folder. If Claude is unavailable, NexQ switches to your fallback provider.',
  },
] as const;
---

<section id="models" class="section border-t border-line" aria-labelledby="models-title">
  <div class="wrap">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">Bring your own AI</p>
        <h2 id="models-title" class="h2 mt-4">Any model you trust. Including the plan you already pay for.</h2>
        <p class="lede">
          Run fully offline with Ollama or LM Studio, connect any of the major APIs, or point NexQ at a custom endpoint.
          Switch at any time; your meetings stay yours.
        </p>
      </div>
      <div class="lg:col-span-7 lg:pt-12" data-reveal style="--reveal-delay: 90ms">
        <p class="mb-4 text-sm text-ink-3">9 AI providers</p>
        <ul class="flex flex-wrap gap-2.5" aria-label="AI providers">
          {LLM_PROVIDERS.map((p) => (
            <li
              class:list={[
                'chip px-3.5! py-1.5! text-[0.9375rem]!',
                p.local && 'border-live/25! text-ink!',
                p.name === 'Claude subscription' && 'border-brand/40! text-ink!',
              ]}
            >
              {p.local && <span class="h-1.5 w-1.5 rounded-full bg-live" aria-hidden="true"></span>}
              {p.name}
              {p.local && <span class="text-xs text-ink-3">local</span>}
              {p.name === 'Claude subscription' && <span class="text-xs text-brand-ink">beta</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Claude subscription spotlight -->
    <div
      id="claude"
      class="relative mt-16 overflow-hidden rounded-3xl border border-line-strong bg-bg-raised sm:mt-20"
      data-reveal
      aria-labelledby="claude-title"
      role="region"
    >
      <div class="grid lg:grid-cols-12">
        <div class="p-6 sm:p-10 lg:col-span-6 lg:p-12">
          <p class="flex items-center gap-2.5">
            <span class="rounded-full bg-brand/15 px-2.5 py-0.5 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-brand-ink">New · Beta</span>
            <span class="text-sm text-ink-3">since v2.22</span>
          </p>
          <h3 id="claude-title" class="mt-5 text-[1.75rem] font-semibold leading-[1.12] tracking-[-0.03em] text-ink sm:text-4xl sm:leading-10">
            Use your Claude Pro or Max plan. No API key.
          </h3>
          <p class="mt-5 text-[1.0625rem] leading-relaxed text-ink-2">
            NexQ talks to the official Claude Code CLI on your computer. You sign in once in Claude's own terminal, and NexQ
            never sees your credentials.
          </p>

          <dl class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2">
            {claudePoints.map((p) => (
              <div>
                <dt class="flex items-center gap-2 font-medium text-ink">
                  <Icon name={p.icon} class="h-4 w-4 text-brand-ink" />
                  {p.title}
                </dt>
                <dd class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink-2">{p.body}</dd>
              </div>
            ))}
          </dl>

          <a
            href={doc('claude-subscription')}
            target="_blank"
            rel="noopener"
            class="link mt-8 inline-flex items-center gap-1 text-[0.9375rem]"
          >
            Set up Claude in NexQ <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
          </a>
        </div>

        <!-- Tier illustration -->
        <div class="border-t border-line bg-bg-sunken/60 p-6 sm:p-10 lg:col-span-6 lg:border-l lg:border-t-0 lg:p-12">
          <div class="flex h-full flex-col justify-center gap-4">
            <p class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3">Default tiers</p>
            {tiers.map((t) => (
              <div class="rounded-2xl border border-line-strong bg-bg-panel p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <p class="text-lg font-semibold text-ink">{t.name}</p>
                  <p class="font-mono text-[0.8125rem] text-ink-2">
                    {t.model} <span class="text-ink-3" aria-hidden="true">·</span> <span class="sr-only">effort</span>{t.effort}
                  </p>
                </div>
                <p class="mt-1.5 text-sm text-ink-3">{t.use}</p>
                <div class="mt-4 flex items-center justify-between border-t border-line pt-3 text-sm">
                  <span class="text-ink-2">Extended thinking</span>
                  <span class:list={['font-mono text-[0.8125rem]', t.thinking === 'On' ? 'text-brand-ink' : 'text-ink-2']}>
                    {t.thinking}
                  </span>
                </div>
              </div>
            ))}
            <div class="flex items-center gap-2.5 rounded-full border border-line-strong bg-bg-panel px-3.5 py-2 text-[0.8125rem] text-ink-2 self-start">
              <span class="live-dot" aria-hidden="true"></span>
              Claude <span class="text-ink-3" aria-hidden="true">·</span> Session ready
            </div>
            <p class="text-xs leading-relaxed text-ink-3">
              Pick any available model and effort for either tier. Usage counts toward your plan; NexQ shows Claude's
              reported numbers as an estimate.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
