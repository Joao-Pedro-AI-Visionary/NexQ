---
import Icon from './Icon.astro';
import { doc } from '../data/site';

const base = import.meta.env.BASE_URL;
const cases = [
  {
    title: 'Interviews',
    body: 'Questions detected as they are asked, answers drawn from your résumé and the job description, and follow-ups ready before the silence gets long.',
    img: 'interview',
    alt: 'NexQ during a live technical interview: two-sided transcript on the left, detected question and AI answer on the right.',
    href: doc('interview-copilot'),
    link: 'Interview copilot guide',
  },
  {
    title: 'Lectures',
    body: 'Long-session transcription, bookmarks for the moments that matter, topic sections and action items, then a summary when class ends.',
    img: 'lecture',
    alt: 'NexQ lecture mode with a running transcript, bookmarks and topic sections.',
    href: doc('lecture-assistant'),
    link: 'Lecture assistant guide',
  },
  {
    title: 'Meetings, and after',
    body: 'Review any past meeting with its transcript, summary, action items and synced audio playback, or simply ask it a question.',
    img: 'past-meeting',
    alt: 'NexQ past meeting review with summary, action items, transcript and an audio playback timeline.',
    href: doc('getting-started'),
    link: 'Getting started',
  },
];
---

<section id="use-cases" class="section border-t border-line" aria-labelledby="use-cases-title">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">Made for</p>
      <h2 id="use-cases-title" class="h2 mt-4">The conversations where you can't afford to miss a thing.</h2>
      <p class="lede">Ready-made scenarios tune prompts and behavior for each situation, and you can write your own.</p>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-3 lg:gap-8">
      {cases.map((c, i) => (
        <article class="flex min-w-0 flex-col" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <img
            src={`${base}img/${c.img}.webp`}
            width="1600"
            height="1180"
            alt={c.alt}
            class="frame aspect-[1600/1180] w-full object-cover object-left-top"
            loading="lazy"
            decoding="async"
          />
          <h3 class="mt-6 text-xl font-semibold tracking-[-0.02em] text-ink">{c.title}</h3>
          <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-2">{c.body}</p>
          <a href={c.href} target="_blank" rel="noopener" class="link mt-4 inline-flex items-center gap-1 self-start text-[0.9375rem]">
            {c.link} <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
