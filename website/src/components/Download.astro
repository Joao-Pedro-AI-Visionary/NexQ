---
import Icon from './Icon.astro';
import { RELEASES_LATEST, REPO, doc } from '../data/site';

const platforms = [
  {
    os: 'windows',
    icon: 'windows',
    name: 'Windows',
    req: 'Windows 10 or 11, x64',
    cta: 'Download for Windows',
    notes: [
      'Per-user installer, no admin rights needed',
      'Updates itself quietly and installs when you quit',
      'Not code-signed yet: on the SmartScreen prompt choose “More info”, then “Run anyway”',
    ],
    badge: '',
  },
  {
    os: 'mac',
    icon: 'apple',
    name: 'macOS',
    req: 'Apple Silicon (M-series) Macs',
    cta: 'Download for macOS',
    notes: [
      'Beta, from v2.25, contributed by the community',
      'Intel Macs are not supported yet',
      'Please report anything odd on GitHub Issues',
    ],
    badge: 'Beta',
  },
] as const;
---

<section id="download" class="section border-t border-line" aria-labelledby="download-title">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">Download</p>
      <h2 id="download-title" class="h2 mt-4">Free. No account. Ready in a minute.</h2>
      <p class="lede">
        Install, pick a speech engine and an AI provider (or use the free local ones), and start any meeting. NexQ picks
        up your system audio automatically.
      </p>
      <p class="mt-4 text-sm text-ink-3" id="os-detected" aria-live="polite"></p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {platforms.map((p, i) => (
        <article
          class="platform group relative flex flex-col rounded-3xl border border-line-strong bg-bg-raised p-6 transition-[border-color,box-shadow] duration-300 sm:p-8"
          data-os={p.os}
          data-reveal
          style={`--reveal-delay: ${i * 80}ms`}
          aria-labelledby={`dl-${p.os}`}
        >
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl border border-line-strong bg-bg-panel text-ink">
                <Icon name={p.icon} class="h-6 w-6" />
              </span>
              <div>
                <h3 id={`dl-${p.os}`} class="flex items-center gap-2 text-xl font-semibold tracking-[-0.02em] text-ink">
                  {p.name}
                  {p.badge && <span class="rounded-full bg-them/10 px-2 py-0.5 text-xs font-medium text-them">{p.badge}</span>}
                </h3>
                <p class="mt-0.5 text-sm text-ink-3">{p.req}</p>
              </div>
            </div>
            <span class="detected-tag hidden rounded-full bg-live/10 px-2.5 py-1 text-xs font-medium text-live">Your system</span>
          </div>

          <ul class="mt-7 space-y-2.5 text-[0.9375rem] text-ink-2">
            {p.notes.map((n) => (
              <li class="flex gap-2.5">
                <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-ink-3" />
                <span>{n}</span>
              </li>
            ))}
          </ul>

          <div class="mt-8 flex-1"></div>
          <a href={RELEASES_LATEST} class="dl-btn btn-ghost w-full">
            <Icon name="download" />
            {p.cta}
          </a>
        </article>
      ))}
    </div>

    <div class="mt-8 flex flex-col gap-3 text-sm text-ink-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-8">
      <a href={doc('getting-started')} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-ink-2">
        Getting started guide <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
      </a>
      <a href={`${REPO}#development`} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-ink-2">
        Build from source <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
      </a>
      <span>Recommended: 8 GB RAM, 16 GB for local speech and AI models.</span>
    </div>
  </div>
</section>

<style>
  .platform.is-detected {
    border-color: rgba(59, 130, 246, 0.45);
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.08);
  }
</style>

<script>
  type OS = 'windows' | 'mac' | 'mobile' | 'other';

  function detectOS(): OS {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string; mobile?: boolean } };
    const ua = navigator.userAgent;
    const platform = (nav.userAgentData?.platform || navigator.platform || '').toLowerCase();
    if (nav.userAgentData?.mobile || /android|iphone|ipad|ipod/i.test(ua)) return 'mobile';
    // iPadOS reports as Mac with touch support
    if (platform.includes('mac') && navigator.maxTouchPoints > 1) return 'mobile';
    if (platform.includes('win') || /windows/i.test(ua)) return 'windows';
    if (platform.includes('mac') || /mac os x/i.test(ua)) return 'mac';
    return 'other';
  }

  const os = detectOS();
  const status = document.getElementById('os-detected');
  const messages: Record<OS, string> = {
    windows: 'Detected Windows. The Windows installer is highlighted below.',
    mac: 'Detected macOS. The Apple Silicon beta is highlighted below. It does not run on Intel Macs.',
    mobile: 'NexQ is a desktop app for Windows and macOS. Open this page on your computer to download it.',
    other: 'NexQ currently ships for Windows and for macOS on Apple Silicon. On other systems you can build it from source.',
  };
  if (status) status.textContent = messages[os];

  if (os === 'windows' || os === 'mac') {
    const card = document.querySelector<HTMLElement>(`.platform[data-os="${os}"]`);
    if (card) {
      card.classList.add('is-detected');
      card.querySelector('.detected-tag')?.classList.remove('hidden');
      const btn = card.querySelector('.dl-btn');
      btn?.classList.remove('btn-ghost');
      btn?.classList.add('btn-primary');
    }
    // Keep the hero and final CTA consistent with the detected platform.
    const label = os === 'mac' ? 'Download for macOS (beta)' : 'Download for Windows';
    document.querySelectorAll('[data-download-label]').forEach((el) => (el.textContent = label));
  } else {
    document.querySelectorAll('[data-download-label]').forEach((el) => (el.textContent = 'Download NexQ'));
  }
</script>
