---
// Same comparison as the project README ("Why NexQ vs. Others?").
type Cell = string | boolean;
const cols = ['NexQ', 'Otter.ai', 'Granola', 'Krisp'];
const rows: { label: string; values: Cell[] }[] = [
  { label: 'Price', values: ['Free', '$8+/mo', '$18/mo', '$16/mo'] },
  { label: 'Open source', values: [true, false, false, false] },
  { label: 'No bot joins the call', values: [true, false, true, true] },
  { label: 'Can run fully local', values: [true, false, 'Partial', 'Partial'] },
  { label: 'Speech-to-text providers', values: ['10', '1', '1', '1'] },
  { label: 'AI providers', values: ['9', '1', '1', '1'] },
  { label: 'Local AI models', values: [true, false, false, false] },
  { label: 'Your documents as context', values: [true, false, false, false] },
];
---

<section id="compare" class="section border-t border-line" aria-labelledby="compare-title">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">Compare</p>
      <h2 id="compare-title" class="h2 mt-4">Your conversations shouldn't be a subscription.</h2>
    </div>

    <div class="relative mt-12 overflow-x-auto rounded-2xl border border-line-strong" data-reveal tabindex="0" role="region" aria-labelledby="compare-title">
      <table class="w-full min-w-[36rem] border-collapse text-left text-[0.9375rem]">
        <caption class="sr-only">NexQ compared with Otter.ai, Granola and Krisp</caption>
        <thead>
          <tr class="border-b border-line">
            <th scope="col" class="px-5 py-4 font-normal text-ink-3"><span class="sr-only">Feature</span></th>
            {cols.map((c, i) => (
              <th scope="col" class:list={['px-4 py-4 text-center font-medium', i === 0 ? 'bg-brand/[0.08] text-ink' : 'text-ink-2']}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-line last:border-0">
              <th scope="row" class="px-5 py-3.5 font-normal text-ink-2">{r.label}</th>
              {r.values.map((v, i) => (
                <td class:list={['px-4 py-3.5 text-center', i === 0 ? 'bg-brand/[0.08] font-medium text-ink' : 'text-ink-3']}>
                  {v === true ? (
                    <span class:list={[i === 0 ? 'text-live' : 'text-ink-2']}>
                      <svg class="mx-auto h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                      <span class="sr-only">Yes</span>
                    </span>
                  ) : v === false ? (
                    <span><span aria-hidden="true">–</span><span class="sr-only">No</span></span>
                  ) : (
                    v
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-xs text-ink-3">
      Competitor pricing and features as listed in the NexQ README; check each vendor for current details. "Can run fully
      local" for NexQ means with local speech and AI providers selected.
    </p>
  </div>
</section>
