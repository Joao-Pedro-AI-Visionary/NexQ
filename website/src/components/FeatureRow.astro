---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  reverse?: boolean;
}
const { id, eyebrow, title, reverse = false } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<article
  id={id}
  class="grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-12 lg:gap-16"
  aria-labelledby={headingId}
>
  <div class:list={['lg:col-span-5', reverse && 'lg:order-2']} data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h3 id={headingId} class="mt-4 text-[1.75rem] font-semibold leading-[1.12] tracking-[-0.03em] text-ink sm:text-4xl sm:leading-10">
      {title}
    </h3>
    <div class="mt-5 space-y-5 text-[1.0625rem] leading-relaxed text-ink-2">
      <slot />
    </div>
  </div>
  <div class:list={['min-w-0 lg:col-span-7', reverse && 'lg:order-1']} data-reveal style="--reveal-delay: 90ms">
    <slot name="visual" />
  </div>
</article>
